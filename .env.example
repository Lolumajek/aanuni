# AANUNI — environment variables
# Copy this file to .env.local for local development. Never commit real
# secrets. See docs/shopify-setup.md and docs/deployment.md for how each
# value is obtained.

# --- Core -------------------------------------------------------------
# When true (default), the app reads typed local fixtures from
# src/lib/fixtures instead of calling Shopify. Fixture content is clearly
# labeled as demo data and must never be shown as a real commercial claim.
DEMO_MODE=true

# Canonical site URL, used for metadata, sitemap and structured data.
SITE_URL=https://aanuni.com

# --- Shopify Storefront API (required when DEMO_MODE=false) ----------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# --- Analytics (optional — adapters stay no-op until set) -------------
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
CLARITY_PROJECT_ID=

# --- Support / Business integrations (optional) ------------------------
SUPPORT_TICKET_PROVIDER_API_KEY=
CRM_API_KEY=
NEWSLETTER_PROVIDER_API_KEY=

# --- Bot / spam protection (optional) -----------------------------------
BOT_PROTECTION_SECRET_KEY=
